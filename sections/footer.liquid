            <span class="sr-only">Instagram</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08a12.05 12.05 0 01-4.123-.06c-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a3.135 3.135 0 110 6.27 3.135 3.135 0 010-6.27zm0 1.802a1.333 1.333 0 100 2.666 1.333 1.333 0 000-2.666zm5.338-3.205a.75.75 0 110 1.5.75.75 0 010-1.5z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Shop -->
      <div>
        <h4 class="font-heading font-bold mb-6 text-white">Shop</h4>
        <ul class="space-y-3 text-neutral-400 text-sm">
          <li><a href="/collections/all" class="hover:text-cyan-500 transition-colors">All Products</a></li>
          <li><a href="/collections/flatware" class="hover:text-cyan-500 transition-colors">Flatware</a></li>
          <li><a href="/collections/serving" class="hover:text-cyan-500 transition-colors">Serving</a></li>
          <li><a href="/collections/specialty" class="hover:text-cyan-500 transition-colors">Specialty</a></li>
          <li><a href="/collections/sets" class="hover:text-cyan-500 transition-colors">Sets</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-heading font-bold mb-6 text-white">Company</h4>
        <ul class="space-y-3 text-neutral-400 text-sm">
          <li><a href="#" class="hover:text-cyan-500 transition-colors">About STAL</a></li>
          <li><a href="#" class="hover:text-cyan-500 transition-colors">Our Philosophy</a></li>
          <li><a href="#" class="hover:text-cyan-500 transition-colors">Materials</a></li>
          <li><a href="#" class="hover:text-cyan-500 transition-colors">Craftsmanship</a></li>
          <li><a href="#" class="hover:text-cyan-500 transition-colors">Blog</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h4 class="font-heading font-bold mb-6 text-white">Support</h4>
        <ul class="space-y-3 text-neutral-400 text-sm">
          <li><a href="#" class="hover:text-cyan-500 transition-colors">Contact Us</a></li>
          <li><a href="#" class="hover:text-cyan-500 transition-colors">Shipping Info</a></li>
          <li><a href="#" class="hover:text-cyan-500 transition-colors">Returns</a></li>
          <li><a href="#" class="hover:text-cyan-500 transition-colors">Care Guide</a></li>
          <li><a href="#" class="hover:text-cyan-500 transition-colors">FAQ</a></li>
        </ul>
      </div>
    </div>

    <!-- Newsletter -->
    <div class="mb-12 pb-12 border-b border-neutral-700" style="max-width: 32rem;">
      <h4 class="font-heading font-bold mb-4 text-white">Subscribe</h4>
      <p class="text-neutral-400 text-sm mb-4">
        Get updates on new products and exclusive offers. No spam, ever.
      </p>
      <form class="flex gap-2">
        <input 
          type="email" 
          placeholder="Enter your email"
          class="flex-1 bg-neutral-800 border border-neutral-700 px-4 py-2 text-white placeholder-neutral-500 focus:outline-none focus:border-cyan-500 transition-colors font-mono text-sm"
        >
        <button 
          type="submit"
          class="px-6 py-2 bg-cyan-500 text-white font-mono font-bold tracking-wider hover:bg-cyan-600 transition-all duration-0"
        >
          SUBSCRIBE
        </button>
      </form>
    </div>

    <!-- Bottom Footer -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-neutral-400 text-sm">
      <p>&copy; 2026 STAL. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-cyan-500 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-cyan-500 transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-cyan-500 transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>

