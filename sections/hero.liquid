<!-- STAL Hero Section -->

<section class="relative h-screen flex items-center justify-center bg-gradient-to-br from-neutral-50 via-neutral-50 to-neutral-100 overflow-hidden">
  <!-- Fracture Line Overlays -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 left-0 right-0 h-px" style="background-color: #E7E5E4;"></div>
    <div class="absolute top-2/3 left-0 right-0 h-px" style="background-color: #E7E5E4;"></div>
  </div>

  <div class="container mx-auto px-4 z-10 text-center" style="max-width: 56rem;">
    <!-- Icon / Visual (Placeholder) -->
    <div class="mb-12 flex justify-center perspective">
      <div class="relative mx-auto" style="width: 6rem; height: 6rem;">
        <svg class="w-full h-full text-neutral-900 animate-pulse" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Fork Icon -->
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M30 20v60c0 5 3 8 8 8h4c5 0 8-3 8-8v-35m-8-30v30m16 5v55c0 5 3 8 8 8h4c5 0 8-3 8-8v-35m-8-30v30" />
          </g>
        </svg>
        <!-- Cyan Accent Glow -->
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-500 to-transparent opacity-0 blur-2xl pointer-events-none animate-pulse"></div>
      </div>
    </div>

    <!-- Headline -->
    <h1 class="text-5xl md:text-7xl font-heading font-bold text-neutral-900 mb-6 leading-tight tracking-tight">
      Precision-Engineered
      <span class="block text-cyan-500">Cutlery</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-lg md:text-2xl text-neutral-600 mb-12 leading-relaxed font-light" style="max-width: 42rem; margin-left: auto; margin-right: auto;">
      Brutalist minimalism meets functional precision. Hand-crafted 18/10 stainless steel flatware designed to last decades.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/collections/all" class="px-8 py-4 bg-neutral-900 text-white font-mono font-bold tracking-wider hover:bg-cyan-500 transition-all duration-0">
        EXPLORE COLLECTION
      </a>
      <a href="#features" class="px-8 py-4 border-2 border-neutral-900 text-neutral-900 font-mono font-bold tracking-wider hover:border-cyan-500 hover:text-cyan-500 transition-all duration-0">
        VIEW SPECS
      </a>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>

  <!-- Background Texture -->
  <svg class="absolute inset-0 w-full h-full opacity-10 pointer-events-none" xmlns="http://www.w3.org/2000/svg">
    <filter id="noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" />
    </filter>
    <rect width="100%" height="100%" filter="url(#noise)" />
  </svg>
</section>

{% stylesheet %}
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  @keyframes subtle-glow {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.5; }
  }

  .animate-pulse {
    animation: subtle-glow 3s ease-in-out infinite;
  }

  .perspective {
    perspective: 1000px;
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Hero Section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Precision-Engineered Cutlery"
      },
      {
        "type": "textarea",
        "id": "subheading",
        "label": "Subheading",
        "default": "Brutalist minimalism meets functional precision. Hand-crafted 18/10 stainless steel flatware designed to last decades."
      }
    ],
    "presets": [
      {
        "name": "Hero"
      }
    ]
  }
{% endschema %}
