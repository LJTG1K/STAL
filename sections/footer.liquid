<!-- STAL Footer -->

<footer class="bg-neutral-900 text-white">
  <div class="container mx-auto px-4 py-20">
    <!-- Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16 pb-12 border-b border-neutral-700">
      <!-- Brand -->
      <div class="space-y-4">
        <h3 class="font-heading text-2xl font-bold text-white">STAL</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Precision-engineered stainless steel flatware. Brutalist design. Lifetime quality.
        </p>
        <div class="flex gap-4 pt-4">
          <a href="#" class="text-neutral-400 hover:text-cyan-500 transition-colors">
            <span class="sr-only">Twitter</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
