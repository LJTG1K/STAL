<!-- STAL Trust Section -->

<section class="bg-neutral-900 text-white py-20 md:py-32">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl md:text-5xl font-heading font-bold mb-16 text-center">
      Crafted for a Lifetime
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Material Specs -->
      <div class="space-y-4">
        <div class="text-cyan-500">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6.707 6.707a1 1 0 010 1.414L5.414 9.414a1 1 0 010 1.414l1.293 1.293a1 1 0 01-1.414 1.414l-2-2a1 1 0 010-1.414l2-2a1 1 0 011.414 0zm6.586 0a1 1 0 011.414 0l2 2a1 1 0 010 1.414l-2 2a1 1 0 11-1.414-1.414L14.586 10.414a1 1 0 010-1.414l-1.293-1.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </div>
        <h3 class="font-heading text-lg font-bold">18/10 Stainless</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Premium grade stainless steel with 18% chromium and 10% nickel. Maximum corrosion resistance.
        </p>
      </div>

      <!-- Warranty -->
      <div class="space-y-4">
        <div class="text-cyan-500">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 11-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM14 2a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0V6h-1a1 1 0 110-2h1V3a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <h3 class="font-heading text-lg font-bold">Lifetime Warranty</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Unconditional warranty against manufacturing defects. Repair or replace with no questions asked.
        </p>
      </div>

      <!-- Returns -->
      <div class="space-y-4">
        <div class="text-cyan-500">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
            <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" />
          </svg>
        </div>
        <h3 class="font-heading text-lg font-bold">30-Day Returns</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Full refund within 30 days, no shipping cost. Complete peace of mind on every order.
        </p>
      </div>

      <!-- Shipping -->
      <div class="space-y-4">
        <div class="text-cyan-500">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
            <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
            <path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z" />
          </svg>
        </div>
        <h3 class="font-heading text-lg font-bold">Free Shipping</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Complimentary standard shipping on orders over $100. Tracked & insured.
        </p>
      </div>
    </div>

    <!-- Additional Trust Content -->
    <div class="mt-16 pt-12 border-t border-neutral-700">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12" style="align-items: center;">
        <div>
          <h3 class="font-heading text-2xl font-bold mb-6">Care Instructions</h3>
          <ul class="space-y-3 text-neutral-400 text-sm">
            <li class="flex gap-3">
              <span class="text-cyan-500" style="flex-shrink: 0;">→</span>
              <span>Hand wash with warm soapy water immediately after use</span>
            </li>
            <li class="flex gap-3">
              <span class="text-cyan-500" style="flex-shrink: 0;">→</span>
              <span>Dry immediately to prevent water spots</span>
            </li>
            <li class="flex gap-3">
              <span class="text-cyan-500" style="flex-shrink: 0;">→</span>
              <span>Avoid abrasive sponges or harsh chemicals</span>
            </li>
            <li class="flex gap-3">
              <span class="text-cyan-500" style="flex-shrink: 0;">→</span>
              <span>Store in a cool, dry place away from moisture</span>
            </li>
          </ul>
        </div>
        <div class="bg-neutral-800 p-8" style="border-radius: 0;">
          <p class="text-sm text-neutral-300 leading-relaxed">
            <strong>Archive-Ready Design:</strong> Every STAL piece is engineered for decades of daily use. With proper care, your flatware will outlive you, becoming a family heirloom.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Trust Section",
    "presets": [
      {
        "name": "Trust Section"
      }
    ]
  }
{% endschema %}
