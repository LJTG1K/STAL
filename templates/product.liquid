<!-- STAL Product Detail Page -->

<div class="container mx-auto px-4 py-12">
  <!-- Breadcrumb Navigation -->
  <nav class="mb-8" aria-label="Breadcrumb">
    <ol class="flex gap-2 text-sm text-neutral-600">
      <li><a href="/" class="hover:text-cyan-500 transition-colors">Home</a></li>
      <li><span class="text-neutral-400">/</span></li>
      <li><a href="/collections/all" class="hover:text-cyan-500 transition-colors">Shop</a></li>
      <li><span class="text-neutral-400">/</span></li>
      <li class="text-neutral-900">{{ product.title }}</li>
    </ol>
  </nav>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <!-- Product Image Gallery -->
    <div class="space-y-4">
      <!-- Main Image -->
      <div class="relative bg-neutral-100 aspect-square overflow-hidden border border-neutral-200 group cursor-zoom-in">
        {% if product.featured_image %}
          <img 
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt }}"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          >
        {% else %}
          <div class="w-full h-full flex items-center justify-center text-neutral-400">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        {% endif %}
      </div>

      <!-- Thumbnail Gallery -->
      <div class="grid grid-cols-4 gap-2">
        {% for image in product.images | slice: 0, 4 %}
          <button 
            class="aspect-square bg-neutral-100 border-2 border-neutral-200 hover:border-cyan-500 transition-colors overflow-hidden"
            aria-label="View image {{ forloop.index }}"
          >
            <img 
              src="{{ image | image_url: width: 200 }}"
              alt="{{ image.alt }}"
              class="w-full h-full object-cover"
              loading="lazy"
            >
          </button>
        {% endfor %}
      </div>

      <!-- 360° Viewer Placeholder -->
      <div class="bg-neutral-950 text-white p-8 rounded text-center">
        <p class="text-sm mb-4">Interactive 360° Viewer</p>
        <p class="text-xs text-neutral-400">Drag to rotate • Pinch to zoom</p>
        <div id="viewer-360" class="w-full aspect-square bg-neutral-800 rounded mt-4 flex items-center justify-center">
          <span class="text-neutral-500">360° view will load here</span>
        </div>
      </div>
    </div>

    <!-- Product Information -->
    <div class="space-y-8">
      <!-- Product Title & Category -->
      <div>
        <p class="text-xs font-mono text-neutral-600 mb-2 tracking-widest">{{ product.type }}</p>
        <h1 class="text-4xl md:text-5xl font-bold font-heading mb-4 text-neutral-900">{{ product.title }}</h1>
        <p class="text-neutral-600 leading-relaxed">{{ product.description }}</p>
      </div>

      <!-- Pricing -->
      <div class="border-t border-neutral-200 pt-6">
        <div class="flex items-baseline gap-4 mb-4">
          <span class="text-3xl font-bold text-neutral-900">
            {{ product.price | money }}
          </span>
          {% if product.compare_at_price %}
            <span class="text-lg text-neutral-500 line-through">
              {{ product.compare_at_price | money }}
            </span>
          {% endif %}
        </div>
        
        {% if product.available %}
          <p class="text-sm text-green-600 font-mono">In stock</p>
        {% else %}
          <p class="text-sm text-red-600 font-mono">Out of stock</p>
        {% endif %}
      </div>

      <!-- Options & Variants -->
      {% if product.has_only_default_variant == false %}
        <div class="border-t border-neutral-200 pt-6 space-y-4">
          <h3 class="font-mono text-sm tracking-widest text-neutral-900">OPTIONS</h3>
          {% for option in product.options_with_values %}
            <div>
              <label class="block text-sm font-mono mb-2 text-neutral-900">
                {{ option.name | upcase }}
              </label>
              <div class="flex flex-wrap gap-2">
                {% for value in option.values %}
                  <button 
                    class="px-4 py-2 border border-neutral-200 hover:border-cyan-500 text-sm font-mono transition-all duration-0"
                    data-option="{{ option.name }}"
                    data-value="{{ value }}"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Quantity Selector & Add to Cart -->
      <div class="border-t border-neutral-200 pt-6 space-y-4">
        <div class="flex items-center gap-4">
          <label for="qty" class="text-sm font-mono tracking-widest">QUANTITY</label>
          <div class="flex items-center border border-neutral-200">
            <button class="px-3 py-2 hover:bg-neutral-100" id="qty-minus">−</button>
            <input 
              type="number" 
              id="qty" 
              name="quantity" 
              value="1" 
              min="1" 
              class="w-12 text-center border-0 outline-none font-mono"
            >
            <button class="px-3 py-2 hover:bg-neutral-100" id="qty-plus">+</button>
          </div>
        </div>

        {% form 'product', product, id: "product-form" %}
          {% unless product.has_only_default_variant %}
            <select name="id" id="product-variant" class="hidden">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                  {{ variant.title }}
                </option>
              {% endfor %}
            </select>
          {% endunless %}

          <input type="hidden" name="quantity" id="qty-input" value="1">

          <button 
            type="submit" 
            class="w-full py-4 bg-cyan-500 hover:bg-cyan-600 text-white font-mono font-bold tracking-wider transition-all duration-0 disabled:opacity-50"
            {% unless product.available %}disabled{% endunless %}
          >
            {% if product.available %}
              ADD TO CART
            {% else %}
              OUT OF STOCK
            {% endif %}
          </button>
        {% endform %}

        <button class="w-full py-3 border-2 border-neutral-200 hover:border-cyan-500 text-neutral-900 font-mono text-sm transition-all duration-0 flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          SAVE FOR LATER
        </button>
      </div>

      <!-- Trust Elements -->
      <div class="border-t border-neutral-200 pt-6 space-y-3 text-sm">
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 text-cyan-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="text-neutral-600">Free shipping on orders over $100</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 text-cyan-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="text-neutral-600">30-day returns • Lifetime warranty</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 text-cyan-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="text-neutral-600">Made from 18/10 stainless steel</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Product Specifications -->
  {% if product.metafields.custom.specifications %}
    <section class="mt-16 border-t border-neutral-200 pt-12">
      <h2 class="text-2xl font-heading font-bold mb-8 text-neutral-900">SPECIFICATIONS</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {% for spec in product.metafields.custom.specifications | split: '|' %}
          {% assign pair = spec | split: ':' %}
          <div class="border-l-2 border-cyan-500 pl-4">
            <p class="text-xs font-mono tracking-widest text-neutral-600 mb-1">{{ pair[0] | strip | upcase }}</p>
            <p class="text-neutral-900">{{ pair[1] | strip }}</p>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- Related Products -->
  {% if product.metafields.custom.related_products %}
    <section class="mt-16 border-t border-neutral-200 pt-12">
      <h2 class="text-2xl font-heading font-bold mb-8 text-neutral-900">YOU MIGHT ALSO LIKE</h2>
      {% assign related = product.metafields.custom.related_products | split: ',' %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for related_id in related limit: 3 %}
          <a href="/products/{{ related_id }}" class="group">
            <div class="bg-neutral-100 aspect-square mb-3 relative overflow-hidden border border-neutral-200 group-hover:border-cyan-500 transition-colors">
              <!-- Placeholder for related product image -->
              <div class="w-full h-full flex items-center justify-center text-neutral-400">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const qtyInput = document.getElementById('qty');
    const qtyMinus = document.getElementById('qty-minus');
    const qtyPlus = document.getElementById('qty-plus');
    const qtySubmitInput = document.getElementById('qty-input');

    qtyMinus.addEventListener('click', () => {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value) - 1);
      qtySubmitInput.value = qtyInput.value;
    });

    qtyPlus.addEventListener('click', () => {
      qtyInput.value = parseInt(qtyInput.value) + 1;
      qtySubmitInput.value = qtyInput.value;
    });

    qtyInput.addEventListener('change', () => {
      qtySubmitInput.value = qtyInput.value;
    });
  });
</script>
