<!-- STAL Featured Collection Section -->

<section class="bg-white py-20 md:py-32 border-t border-neutral-200">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="mb-16" style="max-width: 42rem;">
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-neutral-900 mb-4">
        Featured Pieces
      </h2>
      <p class="text-neutral-600 text-lg leading-relaxed">
        Curated selections from our core collection. Each piece engineered for precision and designed to endure.
      </p>
    </div>

    <!-- Featured Grid (3 Large Items) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      <!-- Feature 1: Dinner Fork -->
      <a href="/products/dinner-fork" class="group">
        <div class="relative bg-neutral-100 aspect-square overflow-hidden border border-neutral-200 mb-4 group-hover:border-cyan-500 transition-all duration-0">
          <!-- Iridescent Overlay on Hover -->
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-500 to-blue-500 opacity-0 group-hover:opacity-10 transition-opacity duration-0 pointer-events-none"></div>
          <!-- Image Placeholder -->
          <div class="w-full h-full flex items-center justify-center">
            <svg class="w-16 h-16 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M5 20h14v-2h-14v2zm0-4h14v-2h-14v2zm0-4h14v-2h-14v2zm0-4h14v-2h-14v2z" />
            </svg>
          </div>
        </div>
        <h3 class="text-lg font-heading font-bold text-neutral-900 mb-2 group-hover:text-cyan-500 transition-colors duration-0">
          Dinner Fork
        </h3>
        <p class="text-sm text-neutral-600 mb-3">
          4-prong precision flatware • Premium 18/10 stainless
        </p>
        <p class="text-neutral-900 font-mono font-bold">$24.99</p>
      </a>

      <!-- Feature 2: Dinner Knife -->
      <a href="/products/dinner-knife" class="group">
        <div class="relative bg-neutral-100 aspect-square overflow-hidden border border-neutral-200 mb-4 group-hover:border-cyan-500 transition-all duration-0">
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-500 to-blue-500 opacity-0 group-hover:opacity-10 transition-opacity duration-0 pointer-events-none"></div>
          <div class="w-full h-full flex items-center justify-center">
            <svg class="w-16 h-16 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M5 20h14v-2h-14v2zm0-4h14v-2h-14v2zm0-4h14v-2h-14v2zm0-4h14v-2h-14v2z" />
            </svg>
          </div>
        </div>
        <h3 class="text-lg font-heading font-bold text-neutral-900 mb-2 group-hover:text-cyan-500 transition-colors duration-0">
          Dinner Knife
        </h3>
        <p class="text-sm text-neutral-600 mb-3">
          Serrated edge blade • Industrial geometry
        </p>
        <p class="text-neutral-900 font-mono font-bold">$26.99</p>
      </a>

      <!-- Feature 3: Flatware Set -->
      <a href="/products/flatware-set" class="group">
        <div class="relative bg-neutral-100 aspect-square overflow-hidden border border-neutral-200 mb-4 group-hover:border-cyan-500 transition-all duration-0">
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-500 to-blue-500 opacity-0 group-hover:opacity-10 transition-opacity duration-0 pointer-events-none"></div>
          <div class="w-full h-full flex items-center justify-center">
            <svg class="w-16 h-16 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M5 20h14v-2h-14v2zm0-4h14v-2h-14v2zm0-4h14v-2h-14v2zm0-4h14v-2h-14v2z" />
            </svg>
          </div>
        </div>
        <h3 class="text-lg font-heading font-bold text-neutral-900 mb-2 group-hover:text-cyan-500 transition-colors duration-0">
          12-Piece Flatware Set
        </h3>
        <p class="text-sm text-neutral-600 mb-3">
          Complete place setting • Archive-ready collection
        </p>
        <p class="text-neutral-900 font-mono font-bold">$199.99</p>
      </a>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a href="/collections/all" class="inline-block px-8 py-4 bg-neutral-900 text-white font-mono font-bold tracking-wider hover:bg-cyan-500 transition-all duration-0">
        BROWSE ALL PRODUCTS
      </a>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Featured Collection",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Section Title",
        "default": "Featured Pieces"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Section Description",
        "default": "Curated selections from our core collection."
      }
    ],
    "presets": [
      {
        "name": "Featured Collection"
      }
    ]
  }
{% endschema %}
