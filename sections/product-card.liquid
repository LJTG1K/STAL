<!-- STAL Product Card Component -->

<a href="{{ product.url }}" class="group block">
  <!-- Product Image -->
  <div class="relative bg-neutral-100 aspect-square overflow-hidden border border-neutral-200 mb-4 group-hover:border-cyan-500 transition-all duration-0">
    <!-- Iridescent Gradient Overlay (Hover) -->
    <div class="absolute inset-0 bg-gradient-to-br from-cyan-500 to-blue-500 opacity-0 group-hover:opacity-10 transition-opacity duration-0 pointer-events-none z-10"></div>
    
    <!-- Blade Shimmer Effect (Hover) -->
    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-0 pointer-events-none z-10 bg-gradient-to-r from-transparent via-white to-transparent" style="animation: shimmer 0.6s ease-in-out;"></div>

    <!-- Image -->
    {% if product.featured_image %}
      <img 
        src="{{ product.featured_image | image_url: width: 500 }}"
        alt="{{ product.featured_image.alt }}"
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      >
    {% else %}
      <div class="w-full h-full flex items-center justify-center">
        <svg class="w-12 h-12 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    {% endif %}

    <!-- Category Badge -->
    <div class="absolute top-3 right-3 bg-cyan-500 text-white text-xs font-mono font-bold px-3 py-1 tracking-wider z-20">
      {{ product.type }}
    </div>
  </div>

  <!-- Product Info -->
  <h3 class="text-base font-heading font-bold text-neutral-900 mb-2 group-hover:text-cyan-500 transition-colors duration-0">
    {{ product.title }}
  </h3>

  <!-- Description -->
  {% if product.description %}
    <p class="text-sm text-neutral-600 mb-3 line-clamp-2">
      {{ product.description | strip_html }}
    </p>
  {% endif %}

  <!-- Material Specs -->
  <div class="flex items-center gap-2 mb-4 text-xs text-neutral-500 font-mono">
    <span class="inline-block">18/10 Stainless</span>
    {% if product.available %}
      <span class="inline-block text-green-600">In Stock</span>
    {% else %}
      <span class="inline-block text-red-600">Out of Stock</span>
    {% endif %}
  </div>

  <!-- Pricing -->
  <div class="flex items-baseline justify-between">
    <div class="text-neutral-900 font-mono font-bold">
      {{ product.price | money }}
      {% if product.compare_at_price %}
        <span class="text-sm text-neutral-500 line-through ml-2">
          {{ product.compare_at_price | money }}
        </span>
      {% endif %}
    </div>
    <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-0">
      <svg class="w-5 h-5 text-cyan-500" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10.5 1.5H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6.5M10.5 1.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 0v3M10.5 4.5h6" />
      </svg>
    </div>
  </div>
</a>

{% stylesheet %}
  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
{% endstylesheet %}
