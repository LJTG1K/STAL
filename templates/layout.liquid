<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_scheme_accent_1 }}">
    
    <title>
      {% if page_title %}
        {{ page_title }} | {{ shop.name }}
      {% else %}
        {{ shop.name }}
      {% endif %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-bg: {{ settings.color_scheme_bg_1 }};
        --color-text: {{ settings.color_scheme_text_1 }};
        --color-accent: {{ settings.color_scheme_accent_1 }};
        --color-accent-hover: {{ settings.color_scheme_accent_1_hover }};
        --color-border: {{ settings.color_scheme_border_1 }};
        --color-secondary: {{ settings.color_scheme_secondary_text }};
        --color-frost: {{ settings.color_scheme_frost_bg }};
      }
    </style>
  </head>

  <body class="bg-neutral-50 text-neutral-900 font-sans antialiased">
    <a href="#main" class="skip-to-main">Skip to main content</a>

    <!-- Header / Navigation -->
    {% section 'header' %}

    <!-- Main Content -->
    <main id="main" class="min-h-screen">
      {{ content_for_layout }}
    </main>

    <!-- Footer -->
    {% section 'footer' %}

    <!-- Scripts -->
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    
    <!-- Digital Grain Overlay (optional, can be moved to CSS) -->
    <svg class="fixed inset-0 pointer-events-none opacity-5 w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <filter id="noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" result="noise" />
      </filter>
      <rect width="100%" height="100%" filter="url(#noise)" />
    </svg>
  </body>
</html>
