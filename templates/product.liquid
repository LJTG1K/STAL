<div class="product-detail">
  <div class="product-grid">
    <div class="product-image-section">
      <div class="product-image">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt }}" class="featured-image">
        {% endif %}
      </div>
      
      {% if product.images.size > 1 %}
        <div class="thumbnail-gallery">
          {% for image in product.images %}
            <img src="{{ image | image_url: width: 100 }}" alt="{{ image.alt }}" class="thumbnail">
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-info-section">
      <h1 class="product-title">{{ product.title }}</h1>
      
      <div class="product-price">
        {% if product.on_sale %}
          <span class="sale-price">{{ product.price | money }}</span>
          <span class="original-price">{{ product.compare_at_price | money }}</span>
        {% else %}
          <span class="price">{{ product.price | money }}</span>
        {% endif %}
      </div>

      <div class="product-description">
        {{ product.description }}
      </div>

      {% if product.variants.size > 1 %}
        <div class="product-variants">
          <label for="variant-select">Variant</label>
          <select id="variant-select" name="variant">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}">
                {{ variant.title }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endif %}

      <form action="/cart/add" method="post" class="product-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <div class="quantity-selector">
          <label for="quantity">Quantity</label>
          <input type="number" id="quantity" name="quantity" value="1" min="1">
        </div>

        <button type="submit" class="btn-primary add-to-cart">
          Add to Cart
        </button>
        
        <button type="button" class="btn-secondary save-for-later">
          Save for Later
        </button>
      </form>

      <div class="trust-elements">
        <p>✓ Free shipping on orders over $100</p>
        <p>✓ 30-day returns</p>
        <p>✓ Lifetime warranty</p>
      </div>
    </div>
  </div>

  {% if product.metafields.custom.specifications %}
    <div class="product-specifications">
      <h3>Specifications</h3>
      {{ product.metafields.custom.specifications }}
    </div>
  {% endif %}

  {% if collection %}
    <div class="related-products">
      <h3>Related Products</h3>
      <div class="product-grid">
        {% for product in collection.products limit: 3 %}
          {% section 'product-card' %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>
